// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// NextAuth.js Required Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  courses   Course[]
  progress  UserProgress[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id              String         @id @default(cuid())
  title           String
  description     String?
  learningOutcomes Json?
  thumbnailUrl    String?
  status          String         @default("active") // 'active' or 'archived'

  // Course customization fields
  difficulty      String         @default("intermediate") // 'beginner', 'intermediate', 'advanced'
  expertiseLevel  String         @default("general") // 'novice', 'intermediate', 'expert', 'general'
  numberOfWeeks   Int            @default(2)
  quizzesPerWeek  Int            @default(2)
  questionsPerQuiz Int           @default(5)

  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  weeks           Week[]
}

model Week {
  id        String   @id @default(cuid())
  title     String
  weekNumber Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules   Module[]
}

enum ContentType {
  READING
  VIDEO
  QUIZ
}

model Module {
  id          String    @id @default(cuid())
  title       String
  contentType ContentType
  content     Json      // AI-generated content
  weekId      String
  week        Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  order       Int
  progress    UserProgress[]
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  isCompleted Boolean  @default(false)

  @@unique([userId, moduleId])
}
